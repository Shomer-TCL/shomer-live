#!/bin/bash
set -euo pipefail
test "$(cat /sys/firmware/qemu_fw_cfg/by_name/opt/shomer/selftest/raw 2>/dev/null)" = 1 || exit 0
kit=/opt/shomer/TCL-Flip2
device=$(blkid -L SHOMER_TEST_BACKUPS)
test -n "$device" || { echo 'SHOMER_TEST_FAIL:no-explicit-test-volume' >/dev/ttyS0; exit 1; }
mkdir -p /mnt/shomer-test
mount "$device" /mnt/shomer-test
exec > >(tee /mnt/shomer-test/boot-test.log /dev/ttyS0) 2>&1
trap 'status=$?; if [ "$status" != 0 ]; then echo SHOMER_TEST_FAIL; fi; sync; systemctl poweroff' EXIT
if [ -f /mnt/shomer-test/offline-first-boot-passed ]; then
  test -s /mnt/shomer-test/offline-backup-retained.txt
  python3 - <<'PY'
import pathlib,zipfile,json,hashlib
verified=0
for path in pathlib.Path('/mnt/shomer-test/mock-sessions').rglob('backup-*.zip'):
    with zipfile.ZipFile(path) as z:
        info=json.loads(z.read('backup-info.json'))
        if not info.get('complete'):continue
        for line in z.read('SHA256SUMS').decode().splitlines():
            expected,name=line.split(maxsplit=1)
            assert hashlib.sha256(z.read(name.lstrip('*'))).hexdigest()==expected
        verified+=1
assert verified>0,'No complete mock backup ZIP survived shutdown'
print('Reopened and checksum-verified retained backup ZIPs:',verified)
PY
  echo SHOMER_PERSISTENCE_PASS
  exit 0
fi
for i in $(seq 1 120); do
  if [ -s /var/run/lightdm/root/:0 ]; then break; fi
  sleep 1
done
export DISPLAY=:0 XAUTHORITY=/var/run/lightdm/root/:0
xdpyinfo >/dev/null
for i in $(seq 1 60); do
  if pgrep -u shomer -x xfce4-session >/dev/null && pgrep -u shomer -x lxpolkit >/dev/null; then break; fi
  sleep 1
done
pgrep -u shomer -x xfce4-session
pgrep -u shomer -x lxpolkit
test "$(find /sys/class/net -mindepth 1 -maxdepth 1 ! -name lo | wc -l)" -eq 0
shomer-check-destination /mnt/shomer-test
if shomer-check-destination /tmp; then echo 'RAM destination was incorrectly accepted'; exit 1; fi
adb version
fastboot --version
mtk --help
avbtool version
superkit --help
lpunpack --help
python=/opt/shomer/TCL-Flip2/Tools/MTKClient/venv/bin/python
"$python" -c 'import serial,usb,PySide6,Crypto,Cryptodome,capstone,unicorn,keystone; print("MTK and GUI dependency imports passed")'
test -n "$(find "$kit/Tools/MTKClient/source/mtkclient/Loader" -name '*.bin' -print -quit)"
test -n "$(find "$kit/Tools/MTKClient/source/mtkclient/payloads" -name '*.bin' -print -quit)"
cd "$kit"
sha256sum -c Checksums-and-manifests/files.sha256 >/mnt/shomer-test/toolkit-checksums.log
for stock in KEKA KEE7; do
  (cd "$kit/Images/Stock/T408DL/$stock" && sha256sum -c SHA256SUMS) >"/mnt/shomer-test/stock-$stock-checksums.log"
done
(cd "$kit/Images/Shomer/2026-11-05_785693c" && sha256sum -c SHA256SUMS) >/mnt/shomer-test/current-image-checksums.log
mkdir -p /mnt/shomer-test/gui /mnt/shomer-test/image-inspection
"$kit/Shomer-Flasher/shomer-flasher" --gui-smoke /mnt/shomer-test/gui
test "$(find /mnt/shomer-test/gui -name '*.png' | wc -l)" -ge 6
# Exercise the actual X11 backend as the live desktop user, with a writable cwd.
install -d -o shomer -g shomer /mnt/shomer-test/mtk-desktop
install -o shomer -g shomer -m 600 "$XAUTHORITY" /mnt/shomer-test/mtk-desktop/xauthority
set +e
(cd /mnt/shomer-test/mtk-desktop && runuser -u shomer -- env DISPLAY=:0 XAUTHORITY=/mnt/shomer-test/mtk-desktop/xauthority QT_QPA_PLATFORM=xcb timeout 10s mtk-gui) >/mnt/shomer-test/mtk-gui.log 2>&1
qt_status=$?
set -e
test "$qt_status" -eq 124
"$kit/Shomer-Flasher/shomer-flasher" --dry-run --no-pause --workdir /mnt/shomer-test/work --log-dir /mnt/shomer-test/logs
# Exercise actual image parsing, not just --help output.
cd /mnt/shomer-test/image-inspection
magiskboot unpack "$kit/Images/Stock/T408DL/KEKA/boot"
test -s ramdisk.cpio
avbtool info_image --image "$kit/Images/Stock/T408DL/KEKA/vbmeta" >/mnt/shomer-test/avb-info.txt
gzip -dc "$kit/Images/Shomer/2026-11-05_785693c/super.raw.gz" > /mnt/shomer-test/current-super.raw
lpunpack --info /mnt/shomer-test/current-super.raw >/mnt/shomer-test/dynamic-partitions.txt
grep -q system /mnt/shomer-test/dynamic-partitions.txt
rm /mnt/shomer-test/current-super.raw
mkdir -p /mnt/shomer-test/mock-sessions
export TMPDIR=/mnt/shomer-test/mock-sessions
python3 "$kit/Tools/Tests/source/e2e.py" "$kit/Tools/Tests/fixture/shomer-flasher-test" >/mnt/shomer-test/mock-console.log
python3 "$kit/Tools/Tests/source/e2e_tui.py" "$kit/Tools/Tests/fixture/shomer-flasher-test" >/mnt/shomer-test/mock-tui.log
printf 'Generated by the offline first boot; must survive shutdown.\n' >/mnt/shomer-test/offline-backup-retained.txt
touch /mnt/shomer-test/offline-first-boot-passed
echo SHOMER_OFFLINE_PASS
