#!/usr/bin/python3
"""Read-only storage command sequence. RAM DA/payload loading may be required.
Does not unlock, flash, erase, format, or automatically fall back to recovery.
"""
import argparse, datetime, hashlib, json, os, pathlib, re, shutil, subprocess, sys

def sha(path):
    h=hashlib.sha256()
    with path.open('rb') as f:
        for b in iter(lambda:f.read(1024*1024),b''): h.update(b)
    return h.hexdigest()

def geometry(output):
    result={}
    for name,key in [('USER','user'),('Boot1','boot1'),('Boot2','boot2')]:
        m=re.search(r'EMMC\s+'+name+r'\s+Size:\s*(0x[0-9a-f]+)',output,re.I)
        if m:result[key]=int(m.group(1),16)
    if set(result)!={'user','boot1','boot2'} or any(n<=0 for n in result.values()):
        raise ValueError('No complete positive eMMC geometry reported; no backup completeness claim is possible')
    for number in range(1,5):
        m=re.search(r'EMMC\s+GP'+str(number)+r'\s+Size:\s*(0x[0-9a-f]+)',output,re.I)
        if m and int(m.group(1),16)>0:result['gp'+str(number)]=int(m.group(1),16)
    return result

def brom_present():
    found=[]
    for p in pathlib.Path('/sys/bus/usb/devices').glob('*'):
        try:
            if (p/'idVendor').read_text().strip()=='0e8d' and (p/'idProduct').read_text().strip()=='0003':found.append(p)
        except OSError: pass
    return len(found)==1

def main():
    ap=argparse.ArgumentParser(description=__doc__);ap.add_argument('--destination',required=True);args=ap.parse_args()
    subprocess.run(['shomer-check-destination',args.destination],check=True)
    print('BROM backup first: phone OFF. Connect while holding the documented volume key(s).')
    print('This handset may not expose BROM. No recovery or unlock fallback is performed here.')
    input('When ready, press Enter to inspect USB state (Ctrl+C cancels): ')
    if not brom_present(): raise ValueError('Exactly one MediaTek BROM device (0e8d:0003) was not found. Stop; consult offline troubleshooting.')
    out=pathlib.Path(args.destination)/('TCL-BROM-'+datetime.datetime.now().strftime('%Y%m%d-%H%M%S'))
    out.mkdir(mode=0o700,exist_ok=False)
    info={'complete':False,'method':'MTKClient read-only BROM storage commands','entries':[],
          'excluded':['RPMB','efuses','secure-world secrets'],'verification':'Two independent reads per reported nonempty eMMC area with equal SHA-256 and expected geometry; not an automatic restore guarantee'}
    def save(): (out/'backup-info.json').write_text(json.dumps(info,indent=2)+'\n')
    save()
    def run(label,argv):
        with (out/(label+'.log')).open('w') as log:
            p=subprocess.run(['mtk',*argv],stdout=log,stderr=subprocess.STDOUT,timeout=14400,cwd=out)
        text=(out/(label+'.log')).read_text(errors='replace')
        if p.returncode: raise ValueError('MTKClient failed; inspect '+label+'.log; backup INCOMPLETE')
        return text
    sizes=geometry(run('geometry',['printgpt']))
    info['geometry']=sizes;save()
    needed=sum(sizes.values())+max(sizes.values())+1024**3
    if shutil.disk_usage(out).free<needed: raise ValueError('Not enough space for complete backup and verification copy')
    for area,size in sizes.items():
        final=out/(area+'.bin');repeat=out/(area+'.verify.partial')
        options=[] if area=='user' else ['--parttype',area]
        for label,path in [('first',final),('second',repeat)]:
            run(area+'-'+label,['rf',str(path),*options])
            if not path.exists() or path.stat().st_size!=size: raise ValueError('Short or missing '+area+' read; backup INCOMPLETE')
        digest=sha(final)
        if sha(repeat)!=digest: raise ValueError('Independent reads differ for '+area+'; backup INCOMPLETE')
        repeat.unlink()
        info['entries'].append({'file':final.name,'size':size,'sha256':digest});save()
    (out/'SHA256SUMS').write_text(''.join(e['sha256']+'  '+e['file']+'\n' for e in info['entries']))
    info['complete']=True;save()
    print('BROM BACKUP COMPLETE for recorded eMMC areas only. Keep it private:',out)
if __name__=='__main__':
    try: main()
    except (Exception,KeyboardInterrupt) as e: print('STOP: '+str(e),file=sys.stderr);sys.exit(1)
